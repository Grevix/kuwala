# Kuwala Environment Configuration Example
# Copy this file to .env and insert your personal API keys

# FRED (Federal Reserve Bank of St. Louis) API Key (Free)
# Sign up: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Nasdaq Data Link API Key (Optional)
# Sign up: https://data.nasdaq.com/sign-up
NASDAQ_DATA_LINK_API_KEY=

# SEC EDGAR Custom User-Agent (Mandatory per SEC fair access policy)
# Format: Sample Company Name AdminContact@<sample company domain>.com
SEC_EDGAR_USER_AGENT=KuwalaResearch/0.1.0 (contact@kuwala.org)

# Local Storage Directory (Optional, defaults to ~/.kuwala/data)
KUWALA_DATA_DIR=
